{
  "name": "bro-workout-teste-automation",
  "version": "1.0.0",
  "description": "Automação de testes E2E do Bro Workout com Playwright e Cucumber",
  "private": true,
  "scripts": {
    "test": "cross-env HEADLESS=false cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:headless": "cross-env HEADLESS=true cucumber-js",
    "test:tags": "cross-env HEADLESS=false cucumber-js --tags",
    "install:browsers": "playwright install chromium",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/test": "^1.55.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "playwright": "^1.55.0"
  }
}
